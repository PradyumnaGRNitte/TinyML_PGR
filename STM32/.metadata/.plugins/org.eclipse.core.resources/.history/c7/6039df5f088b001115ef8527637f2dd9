#ifndef INC_BH1750_H_
#define INC_BH1750_H_


#define BH1750_ADDR 0x23  //macro to define I2C add of BH1750

void BH1750_Init(I2C_HandleTypeDef *hi2c); //hi2c1 not needed later we handover
float BH1750_ReadLux(I2C_HandleTypeDef *hi2c);



void BH1750_Init(I2C_HandleTypeDef *hi2c)
{   unit8_t cmd[]={0x10};
	HAL_I2C_Master_Transmit(hi2c, BH1750_ADDR<<1, cmd, Size, Timeout);
}


#endif /* INC_BH1750_H_ */
